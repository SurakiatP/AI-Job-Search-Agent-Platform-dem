# Local configuration for scripts/run_local.py and scripts/local_infra.py.
# Copy to .env (git-ignored) and adjust; load with:
#   uv run --env-file .env --locked --project backend python scripts/run_local.py --open-browser
#
# What belongs where:
#  * Here (.env): service addresses, optional path overrides and the two keys marked SECRET below.
#  * Never here: generated infrastructure secrets (Postgres/MinIO passwords, LiteLLM master and salt
#    keys, LiteLLM database and UI passwords). scripts/local_infra.py generates them into
#    CORE02_PRIVATE_DIR (mode 0600); the app reads them from there.
#  * Use absolute paths; ~ and $HOME are not expanded.

# --- Secrets (leave empty here if you export them in the shell instead) ---
# SECRET. OpenRouter key; reaches only the LiteLLM container, at `local_infra.py start`.
OPENROUTER_API_KEY=
# SECRET, optional. LiteLLM virtual key for the app; empty falls back to the litellm_app_key file in CORE02_PRIVATE_DIR.
LITELLM_API_KEY=

# --- Service addresses (defaults shown; change them to run the app apart from the services) ---
JSP_POSTGRES_HOST=127.0.0.1
JSP_POSTGRES_PORT=55432
JSP_MINIO_ENDPOINT=http://127.0.0.1:59000
LITELLM_BASE_URL=http://127.0.0.1:54000
# Langfuse tracing: set to http://127.0.0.1:53000 to run the langfuse profile and export run spans
LANGFUSE_HOST=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Optional overrides (defaults shown) ---
# CORE02_PRIVATE_DIR, MINIO_SOURCE_DIR and GOSU_SOURCE_DIR are optional: local_infra.py, the app, backup
# and restore all fall back to these same defaults, so set them only to move the directories.
# CORE02_PRIVATE_DIR=/Users/YOU/.cache/job-search-platform/core02-runtime-20261003
# MINIO_SOURCE_DIR=/Users/YOU/.cache/job-search-platform/upstream/minio
# GOSU_SOURCE_DIR=/Users/YOU/.cache/job-search-platform/upstream/gosu
# PROMETHEUS_SOURCE_DIR=/Users/YOU/.cache/job-search-platform/upstream/prometheus
# CADDY_SOURCE_DIR=/Users/YOU/.cache/job-search-platform/upstream/caddy
# GRAFANA_PROM_DS_SOURCE_DIR=/Users/YOU/.cache/job-search-platform/upstream/grafana-prometheus-datasource
# JSP_DATABASE=jobsearch_platform_core02
# JSP_PRIVATE_BUCKET=job-search-platform-private
# JSP_DEV_ORIGIN=http://127.0.0.1:5173
# JSP_LOG_LEVEL=INFO
# AI_ANALYZE_MODEL=ai-analyze
# AI_DECISION_MODEL=typesafe/jev-1.13
# Host ports published by the storage stack (CORE02_POSTGRES_PORT is the legacy name of JSP_POSTGRES_PORT)
# CORE02_POSTGRES_PORT=55432
# CORE02_MINIO_PORT=59000
# CORE02_LITELLM_PORT=54000
# CORE02_LANGFUSE_PORT=53000
# CORE02_MEILI_PORT=57700
# CORE02_PROMETHEUS_PORT=59090
# CORE02_GRAFANA_PORT=53300
# CORE02_MAILPIT_SMTP_PORT=51025
# CORE02_MAILPIT_UI_PORT=58025

# --- Public addresses (production; leave unset for local use) ---
# Address users open in the browser; sign-in cookies only work from this origin.
# APP_PUBLIC_ORIGIN=https://jobs.example.com
# Address of the shared listener (MCP, A2A, OAuth) when --enable-sharing is used.
# SHARE_PUBLIC_ORIGIN=https://agents.example.com

# --- Limits ---
# AI runs per user per day (evaluation, documents, tailoring, Smart match).
# USER_DAILY_RUN_QUOTA=30
# Interview-practice AI runs per user per day (questions, feedback, summary).
# USER_DAILY_PRACTICE_QUOTA=60
# Set to 1 only in a closed test network: lets webhooks call private addresses.
# WEBHOOK_ALLOW_PRIVATE=

# --- Telegram digests ---
# Turned on by the file CORE02_PRIVATE_DIR/telegram-bot-token (mode 0600), never by a variable here.

# --- Search index ---
# MEILI_URL=http://127.0.0.1:57700
# MEILI_INDEX=jobs

# --- Metrics and Grafana (WP1) ---
# Unset METRICS_PORT means no metrics listener. If you change it, also change the target in infra/prometheus/prometheus.yml.
# METRICS_PORT=59464
# Must be a loopback address.
# METRICS_HOST=127.0.0.1
# PROMETHEUS_RETENTION=15d
# The Grafana admin password lives in CORE02_PRIVATE_DIR/grafana-admin-password, never here.
# GRAFANA_ADMIN_USER=admin

# Operator access: comma-separated verified account emails allowed to see the AI gateway settings (empty = nobody).
# ADMIN_EMAILS=you@example.com

# Outbound email (sign-up codes, password reset, digests). Without SMTP_HOST or
# SMTP_PROVIDER no email is sent and the sign-up page says so.
# Gmail or Outlook: turn on 2-step verification, create an app password, save it
# in a file only you can read, and point SMTP_PASSWORD_FILE at it.
# SMTP_PROVIDER=gmail            # or outlook; sets host and port 587 with STARTTLS
# SMTP_USERNAME=you@gmail.com    # also used as the sender
# SMTP_PASSWORD_FILE=~/.config/job-search-platform/smtp-password
# Any other server: SMTP_HOST, SMTP_PORT, SMTP_STARTTLS, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM
