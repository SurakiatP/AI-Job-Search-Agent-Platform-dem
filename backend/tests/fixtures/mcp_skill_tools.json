  "jobs_search": {
    "description": "Search public Thailand job postings. Returns up to 50 postings with the full description (markdown or plain text), posting age in days and a stale flag. Read-only; creates no Task.",
    "input_schema": {
      "$defs": {
        "AgentJobSearch": {
          "additionalProperties": false,
          "description": "Direct jobs_search input: one page of the public job source with full descriptions.",
          "properties": {
            "category": {
              "anyOf": [
                {
                  "pattern": "^[a-z0-9_-]{1,60}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Category"
            },
            "cities": {
              "default": [],
              "items": {
                "maxLength": 60,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 5,
              "title": "Cities",
              "type": "array"
            },
            "description_format": {
              "default": "markdown",
              "enum": [
                "markdown",
                "text"
              ],
              "title": "Description Format",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "posted_within_days": {
              "anyOf": [
                {
                  "maximum": 90,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Posted Within Days"
            },
            "q": {
              "default": "",
              "maxLength": 200,
              "title": "Q",
              "type": "string"
            },
            "work_mode": {
              "anyOf": [
                {
                  "enum": [
                    "remote",
                    "hybrid",
                    "onsite"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Work Mode"
            }
          },
          "title": "AgentJobSearch",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/AgentJobSearch"
        }
      },
      "required": [
        "request"
      ],
      "title": "jobs_searchArguments",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "jobs_searchDictOutput",
      "type": "object"
    }
  },
