[Unit]
Description=Daily backup with 7-day local retention
After=docker.service

[Service]
Type=oneshot
User=jsp
Group=jsp
WorkingDirectory=/opt/job-search-platform/current
EnvironmentFile=/etc/job-search-platform/private/app.env
Environment=HOME=/var/lib/job-search-platform
# RuntimeDirectory is removed after ExecStopPost when the unit stops (default RuntimeDirectoryPreserve=no), so no stale marker survives a run.
RuntimeDirectory=job-search-backup
ExecStartPre=+/bin/sh -c 'if /usr/bin/systemctl is-active --quiet job-search-platform; then touch /run/job-search-backup/was-active; fi; /usr/bin/systemctl stop job-search-platform'
ExecStart=/bin/bash -c 'uv run --locked --project backend python scripts/backup.py --archive /var/backups/job-search-platform/daily-$(date -u +%%Y%%m%%dT%%H%%M%%SZ)'
ExecStartPost=/usr/bin/find /var/backups/job-search-platform -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} +
ExecStopPost=+/bin/sh -c 'if [ -f /run/job-search-backup/was-active ]; then rm -f /run/job-search-backup/was-active; /usr/bin/systemctl start job-search-platform; fi'
